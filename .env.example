BOT_TOKEN=
DATABASE_PATH=data/release.sqlite
# Optional. Personal AI needs caller consent; shared data needs both partners.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Bookkeeping exchange rate, not a live quote. 0 = ruble estimate unavailable.
BILLING_USD_RUB=0
# Notification only; never stops requests. 0 disables the notification.
BILLING_TARGET_RUB=0
# Owner dashboard (loopback :8080). Generate a random password, 24+ characters.
PANEL_PASSWORD=
BOT_USERNAME=relation_support_bot
BACKUP_DIR=data/backups

# Optional isolated owner-only simulator. Create a DIFFERENT bot in BotFather.
TEST_BOT_TOKEN=
TEST_OWNER_ID=0
TEST_DATABASE_PATH=data/sandbox.sqlite
